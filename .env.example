DATA_API_URL=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
# model ids and USD price per 1M tokens (prices for Claude and known Gemini models are built in)
GEMINI_MODEL=
GEMINI_PRICE_IN=
GEMINI_PRICE_OUT=
OPENAI_MODEL=
OPENAI_PRICE_IN=
OPENAI_PRICE_OUT=
# evaluator.evaluate(): models in order; if one fails after retries, the next one is used
EVAL_MODELS=claude-sonnet-5-5,claude-opus-5-5,gemini-3.5-flash-lite
# time limit for one evaluation, seconds (all models together)
EVAL_TIMEOUT=120
# Claude thinking effort: low / medium / high (more = steadier answers, slower and pricier)
EVAL_EFFORT=low
# extra/overridden prices, USD per 1M tokens: name:input/output, comma-separated
MODEL_PRICES=
# team name for the organizers' results file (export_results.py)
TEAM_NAME=-60HZ
# group_id of the PROD dialogs for GET /api/export?set=prod (or put the file into data/raw/prod.json)
PROD_GROUP_ID=
